{
  "name": "crossing-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "img:optimise": "node scripts/optimise-images.mjs",
    "img:push": "node scripts/img-r2.mjs push",
    "img:pull": "node scripts/img-r2.mjs pull",
    "img:check": "node scripts/img-r2.mjs check",
    "img:build": "node scripts/img-r2.mjs pull && node scripts/optimise-images.mjs && node scripts/img-r2.mjs push",
    "coast:med": "node scripts/gen-coast.mjs med",
    "coast:board": "node scripts/gen-coast.mjs board"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}