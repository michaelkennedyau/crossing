{
  "name": "crossing",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "IL VARO \u2014 The Crossing. A scroll-cinematic voyage + live instrument bridge, on the Varo engine.",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && tsc --noEmit",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "wrangler d1 execute varo-family-brain --remote --file=sql/crossing_schema.sql",
    "db:apply:local": "wrangler d1 execute varo-family-brain --local --file=sql/crossing_schema.sql",
    "db:apply:north": "wrangler d1 execute varo-family-brain --remote --file=sql/north_schema.sql",
    "db:apply:north:local": "wrangler d1 execute varo-family-brain --local --file=sql/north_schema.sql",
    "db:seed:events": "wrangler d1 execute varo-family-brain --remote --file=sql/north_events_seed.sql",
    "db:apply:south": "wrangler d1 execute varo-family-brain --remote --file=sql/south_schema.sql",
    "db:seed:south-intel": "wrangler d1 execute varo-family-brain --remote --file=sql/south_intel_seed.sql",
    "db:apply:journal": "wrangler d1 execute varo-family-brain --remote --file=sql/journal_schema.sql",
    "db:apply:journal:local": "wrangler d1 execute varo-family-brain --local --file=sql/journal_schema.sql",
    "db:seed:journal": "node --experimental-strip-types scripts/journal-seed-build.ts && wrangler d1 execute varo-family-brain --remote --file=sql/journal_seed.sql",
    "db:seed:journal:local": "node --experimental-strip-types scripts/journal-seed-build.ts && wrangler d1 execute varo-family-brain --local --file=sql/journal_seed.sql",
    "db:apply:traversata": "wrangler d1 execute varo-family-brain --remote --file=sql/traversata_schema.sql",
    "db:seed:traversata": "node --experimental-strip-types scripts/traversata-seed-build.ts && wrangler d1 execute varo-family-brain --remote --file=sql/traversata_seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.90.1"
  }
}
